title_wae="Aktualisierige verfiegbar"
message_wae="Machid schi sealber"

title_wal="Ooratho de'ees"
message_wal="Ne huucci ootta"

title_wo="Yeesalu am na"
message_wo="Def ko sa bopp"

title_xh="Uhlaziyo lukhona"
message_xh="Kwenze ngesandla"

title_yi="פֿאַראַנען אַפּדעיטס"
message_yi="טו זיי אַליין"

title_yo="Àwọn ìmúdójuìwọ̀n wà"
message_yo="Ṣe wọ́n fúnra rẹ"

title_yue="有更新可用"
message_yue="請手動執行"

title_yuw="Update i stap"
message_yuw="Mekim yu yet"

title_zh="有可用更新"
message_zh="请手动执行"

title_zu="Izibuyekezo ziyatholakala"
message_zu="Zenze ngesandla"


mainFunction () {
	local translation; translation="$(translation)"

	if ! updatingIsWorking; then
		local title="title_${translation}"
		local message="message_${translation}"
	
		notify \
			"${!title}" \
			"${!message}"
	fi
}


errorsAreLogged () {
	[[ "$(LANG="C.utf8" journalctl --boot=-1 --unit=pacman-auto-update.service --priority=err 2>&1)" != "-- No entries --" ]]
}


language () {
	echo "${LANG}" |
	cut --delimiter='.' --fields=1 |
	cut --delimiter='_' --fields=1
}


notify () {
	local title="${1}"
	local message="${2}"
	local seconds=300
	
	notify-send \
		--icon="system-software-install" \
		--expire-time="${seconds}000" \
		"${title}" \
		"${message}"
}


translation () {
	local language; language="$(language)"
	
	if grep --quiet "^message_${language}" "${0}"; then
		echo "${language}"
	else
		echo "en"
	fi
}


timerIsEnabled () {
	systemctl is-enabled --quiet pacman-auto-update.timer
}


updatingIsWorking () {
	! timerIsEnabled || ! errorsAreLogged
}


mainFunction
